# cp .env.example .env  후 필요한 값만 수정
# (.env 는 절대 커밋하지 말 것)

# --- 접속 ---
# 127.0.0.1 = 이 PC 에서만. 로그인이 없으므로 0.0.0.0 으로 열지 말 것.
# 외부에서 쓰려면 호스트에서 `tailscale serve --bg 8080` (README 참고)
WEB_BIND=127.0.0.1
WEB_PORT=8080

# --- 모델 / 추론 ---
DEMUCS_MODEL=htdemucs
DEVICE=auto
# 품질을 올리고 싶으면 2~5. 시간이 배수로 늘어난다.
SHIFTS=1
OVERLAP=0.25
# VRAM 부족(OOM) 시에만 5~7 정도로 지정. 비워두면 모델 기본값.
SEGMENT=

# --- 출력 ---
MP3_BITRATE=320k
# PCM_16 | PCM_24 | FLOAT
WAV_SUBTYPE=PCM_16

# --- 제한 ---
MAX_DURATION_SEC=900
MAX_QUEUE=20
# 0 = 결과물을 자동으로 지우지 않음(권장). 보관함으로 쓰기 때문.
# 양수를 주면 그 초 이상 지난 완료 작업의 폴더를 자동 삭제한다.
JOB_RETENTION_SEC=0

# --- yt-dlp ---
# 봇 확인에 걸리면 쿠키를 secrets/cookies.txt 로 두고 아래 주석을 해제
# COOKIES_FILE=/secrets/cookies.txt
# 다운로드가 403 으로 막히면 이 순서대로 플레이어 클라이언트를 바꿔가며 재시도한다.
# 맨 앞 빈 항목은 yt-dlp 기본값. (실측: 기본은 403, android 는 통과)
YTDLP_CLIENTS=,android,tv,web_safari,ios,mweb
# 다운로드가 깨지기 시작하면 버전을 올리고 재빌드
YTDLP_VERSION=2026.7.4
