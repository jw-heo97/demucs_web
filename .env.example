# cp .env.example .env  후 필요한 값만 수정
# (.env 는 절대 커밋하지 말 것)

# --- 접속 ---
# 127.0.0.1 = 이 PC 에서만.  0.0.0.0 = LAN 전체 공개(방화벽으로 막을 것)
WEB_BIND=127.0.0.1
WEB_PORT=8080

# --- 모델 / 추론 ---
DEMUCS_MODEL=htdemucs
DEVICE=auto
# 품질을 올리고 싶으면 2~5. 시간이 배수로 늘어난다.
SHIFTS=1
OVERLAP=0.25
# VRAM 부족(OOM) 시에만 5~7 정도로 지정. 비워두면 모델 기본값.
SEGMENT=

# --- 출력 ---
MP3_BITRATE=320k
# PCM_16 | PCM_24 | FLOAT
WAV_SUBTYPE=PCM_16

# --- 제한 ---
MAX_DURATION_SEC=900
MAX_QUEUE=20
# 0 = 결과물을 자동으로 지우지 않음(권장). 보관함으로 쓰기 때문.
# 양수를 주면 그 초 이상 지난 완료 작업의 폴더를 자동 삭제한다.
JOB_RETENTION_SEC=0

# --- 인증 ---
ADMIN_USER=admin
# 비워두면 첫 기동 때 임의 비밀번호를 생성해 로그에 한 번만 출력한다.
#   docker compose logs api | Select-String "비밀번호"
ADMIN_PASSWORD=
SESSION_DAYS=30
LOGIN_MAX_FAILS=5
LOGIN_LOCK_SEC=300

# --- 접속 IP 기록 ---
# ⚠ Docker Desktop for Windows 는 출발지 IP 를 보존하지 않는다(실측 확인).
#   컨테이너는 LAN 접속도 원격 접속도 전부 172.x.0.1 로 본다.
#   Windows 호스트에 리버스 프록시를 둬서 X-Forwarded-For 를 넘기는 경우에만 1 로 켤 것.
#   PROXY_SECRET 을 함께 넣으면 헤더 위조를 막는다. (README "접속 IP 기록" 참고)
TRUST_PROXY_HEADER=0
PROXY_SECRET=

# --- yt-dlp ---
# 봇 확인에 걸리면 쿠키를 secrets/cookies.txt 로 두고 아래 주석을 해제
# COOKIES_FILE=/secrets/cookies.txt
# 다운로드가 403 으로 막히면 이 순서대로 플레이어 클라이언트를 바꿔가며 재시도한다.
# 맨 앞 빈 항목은 yt-dlp 기본값. (실측: 기본은 403, android 는 통과)
YTDLP_CLIENTS=,android,tv,web_safari,ios,mweb
# 다운로드가 깨지기 시작하면 버전을 올리고 재빌드
YTDLP_VERSION=2026.7.4

# 앱 전체를 특정 역할로 제한하려면 채운다 (예: admin).
# 비워두면 로그인한 사용자는 누구나 쓸 수 있고,
# 보안 화면(계정 관리·접속 기록)만 관리자로 막힌다.
REQUIRE_ROLE=
