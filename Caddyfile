{
	admin off
	auto_https off
}

:8080 {
	# remote_ip = 실제 TCP 피어 주소.
	# client_ip 를 쓰면 안 된다 — 그건 X-Forwarded-For 헤더를 믿기 때문에
	# 클라이언트가 헤더를 위조해서 화이트리스트를 통과할 수 있다.
	@allowed remote_ip {$ALLOWED_IPS}

	handle @allowed {
		# 업로드/다운로드가 커서 타임아웃을 넉넉히 준다 (긴 곡 = 수백 MB)
		reverse_proxy demucs-api:8000 {
			flush_interval -1
		}
	}

	handle {
		respond "403 Forbidden — 허용되지 않은 주소입니다." 403 {
			close
		}
	}

	log {
		output stdout
		format console
	}
}
